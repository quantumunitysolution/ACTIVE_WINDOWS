{
  "type": "commonjs",
  "dependencies": {
    "active-win": "^8.2.1",
    "better-sqlite3": "^11.10.0",
    "electron-store": "^8.2.0",
    "ws": "^8.18.3"
  },
  "name": "active_url",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist:win": "electron-builder --win",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.quantumunity.activewindows",
    "productName": "ActiveWindows",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "publisherName": "QuantumUnitySolution"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": "",
  "devDependencies": {
    "electron": "^23.3.13",
    "electron-builder": "^23.6.0"
  },
  "license": "ISC",
  "description": ""
}
